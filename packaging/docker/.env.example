# ---------------------------------------------------------------------------
# Tessera (web app) settings. Copy to .env and edit, then: docker compose up -d
# ---------------------------------------------------------------------------

# Image version (see https://github.com/MrNechev/tessera/releases)
TESSERA_VERSION=latest

# Login password (empty = no login; only do that on a trusted network)
TESSERA_PASSWORD=change-me

# ----- Media libraries -----------------------------------------------------
# Folders with your photos and videos. The ID is stored in documents with every
# media reference: pick it once and keep it.
# Libraries are READ-ONLY by default: Tessera reads them for the library,
# documents and tools, and saves results to OUTPUTS_DIR instead.
LIBRARY_1_ID=main
LIBRARY_1_NAME=Photos
LIBRARY_1_PATH=/mnt/photos
#LIBRARY_1_MODE=ro          # rw = mount writable (also add the id to WRITABLE_LIBRARIES)

# Up to three more (leave the PATH empty to disable)
#LIBRARY_2_ID=phone
#LIBRARY_2_NAME=Phone
#LIBRARY_2_PATH=/mnt/photos/phone
#LIBRARY_2_MODE=ro
#LIBRARY_3_ID=
#LIBRARY_3_NAME=
#LIBRARY_3_PATH=
#LIBRARY_4_ID=
#LIBRARY_4_NAME=
#LIBRARY_4_PATH=

# Libraries the tools may write to (e.g. "convert, replace originals"). A library
# is writable only if it is listed here AND mounted with LIBRARY_n_MODE=rw.
#WRITABLE_LIBRARIES=phone

# ----- Storage ---------------------------------------------------------------
DATA_DIR=./data         # documents, collage projects, settings, index, certificate (back this up)
CACHE_DIR=./cache       # thumbnails, video proxies, temporary uploads (an SSD; safe to delete)
OUTPUTS_DIR=./outputs   # results of the tools and collages (shown as the "Outputs" library)
INBOX_DIR=./inbox       # uploads you chose to keep (shown as the "Inbox" library)
PUID=1000               # user/group that owns the folders above
PGID=1000

# ----- Network ---------------------------------------------------------------
TESSERA_HTTP_PORT=8470
TESSERA_HTTPS_PORT=8471
# Every name/IP you open Tessera with over HTTPS (goes into the self-signed certificate)
TESSERA_TLS_HOSTS=localhost,127.0.0.1
# Use your own certificate instead of the generated one (paths inside the container)
#TESSERA_TLS_CERT=/data/tls/my.crt
#TESSERA_TLS_KEY=/data/tls/my.key

TZ=UTC

# ----- Uploads ---------------------------------------------------------------
# Largest single upload in MB (videos from your computer); 0 = unlimited
#TESSERA_MAX_UPLOAD_MB=0

# ----- Performance (defaults are derived from the machine) -------------------
#TESSERA_THUMB_WORKERS=        # default: CPU threads
#TESSERA_PROBE_WORKERS=        # default: CPU threads
#TESSERA_SCAN_WORKERS=         # default: CPU threads
#TESSERA_VIDEO_WORKERS=        # parallel proxy transcodes, default: max(2, threads/4)
#TESSERA_HWACCEL=auto          # auto | vaapi | none
#TESSERA_VAAPI_DEVICE=/dev/dri/renderD128
#TESSERA_BACKGROUND_THUMBS=true      # pre-generate grid thumbnails for the whole library
# Folders/files never indexed (comma-separated patterns on names or library paths).
#TESSERA_EXCLUDE=*_files,Private/*,*.tmp
#TESSERA_PROXY_DOCUMENT_VIDEOS=true  # prepare proxies for videos used in documents
#TESSERA_PREVIEW_HEIGHT=1080         # in-document preview proxy size (short side)
#TESSERA_PREVIEW_MIN_HEIGHT=1440     # videos bigger than this get a preview proxy
#TESSERA_PREVIEW_MIN_MBPS=20         # ...or with a higher bitrate
#TESSERA_PLAYABLE_VIDEO_CODECS=h264,vp8,vp9,av1   # add hevc if all your browsers play it
#TESSERA_SCAN_INTERVAL=30m
#TESSERA_WATCH=true
#TESSERA_HISTORY_KEEP=30
#TESSERA_LOG_LEVEL=info
