{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tessera",
  "mainBinaryName": "tessera",
  "version": "../package.json",
  "identifier": "io.github.mrnechev.Tessera",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "beforeBundleCommand": "node scripts/prepare-bundle.mjs"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Tessera",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "dragDropEnabled": true,
        "backgroundColor": "#16141d"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost",
        "script-src": "'self'",
        "worker-src": "'self' blob:"
      },
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$APPCACHE/**",
            "$APPDATA/projects/**"
          ],
          "deny": []
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "category": "GraphicsAndDesign",
    "shortDescription": "Photo collage studio and image toolkit",
    "longDescription": "Tessera is a creative photo collage studio and image Swiss Army knife. Build quick automatic collages or hand-crafted designs with templates, text, stickers, shapes and borders, then convert and compress images while keeping the metadata you care about.",
    "publisher": "Tessera contributors",
    "copyright": "Copyright \u00a9 2026 Tessera contributors",
    "license": "GPL-3.0-or-later",
    "homepage": "https://github.com/MrNechev/tessera",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "graphics",
        "depends": [
          "libheif1 (>= 1.17)",
          "libdav1d7"
        ],
        "recommends": [
          "libheif-plugin-libde265"
        ],
        "desktopTemplate": "../packaging/linux/tessera.desktop.hbs",
        "files": {
          "/usr/share/metainfo/io.github.mrnechev.Tessera.metainfo.xml": "gen/linux/io.github.mrnechev.Tessera.metainfo.xml",
          "/usr/share/mime/packages/io.github.mrnechev.Tessera.xml": "../packaging/linux/io.github.mrnechev.Tessera.mime.xml"
        }
      },
      "rpm": {
        "depends": [
          "libheif.so.1()(64bit)",
          "libdav1d.so.7()(64bit)"
        ],
        "desktopTemplate": "../packaging/linux/tessera.desktop.hbs",
        "files": {
          "/usr/share/metainfo/io.github.mrnechev.Tessera.metainfo.xml": "gen/linux/io.github.mrnechev.Tessera.metainfo.xml",
          "/usr/share/mime/packages/io.github.mrnechev.Tessera.xml": "../packaging/linux/io.github.mrnechev.Tessera.mime.xml"
        }
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
