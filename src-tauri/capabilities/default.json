{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities of the main Tessera window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "dialog:default",
    "window-state:default",
    "allow-reveal-path",
    "allow-open-path",
    "allow-open-url",
    "allow-startup-files",
    "allow-autotest-script",
    "allow-autotest-log",
    "allow-print-native",
    "core:webview:default",
    "core:event:default"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*",
      "http://localhost:*"
    ]
  }
}
